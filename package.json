    "pg": "^8.11.5",
    "jose": "^5.2.3",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.11.2",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2"
  }
