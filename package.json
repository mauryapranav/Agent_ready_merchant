    "redteam": "tsx src/metrics/redteam.ts",
    "rzp:integration": "tsx scripts/rzp-integration.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
